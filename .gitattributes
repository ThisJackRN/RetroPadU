* text=auto

# Windows scripts need CRLF (cmd.exe labels and GOTO misbehave with LF).
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Built and run in WSL/devkitPro shells.
*.sh text eol=lf
*.c text eol=lf
*.ld text eol=lf

# Game and homebrew binaries
*.bin binary
*.dol binary
*.szs binary
*.thp binary
*.tpl binary
*.Font binary
